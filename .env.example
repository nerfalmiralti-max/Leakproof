# Explicit mode selection. No automatic fallback from real analysis to demo.
ANALYSIS_PROVIDER=demo
# Required on the SERVER only when ANALYSIS_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_WATER_GATE_MODEL=gpt-4.1-mini
OPENAI_TEMPORAL_MODEL=gpt-5.6-terra

# Shared real reports. No browser anon key is needed.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DISPATCHER_ACCESS_KEY=
